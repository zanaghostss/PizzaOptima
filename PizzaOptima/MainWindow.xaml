<Window x:Class="PizzaOptima.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍕 Pizza Optima — Operations Research Command Center"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#16100D">

    <Window.Resources>
        <!-- Palette: wood-fired oven — warm charcoal, flame orange, cheese gold, basil green -->
        <SolidColorBrush x:Key="Card"     Color="#221A15"/>
        <SolidColorBrush x:Key="CardLine" Color="#3A2C24"/>
        <SolidColorBrush x:Key="Flame"    Color="#FF7A2F"/>
        <SolidColorBrush x:Key="Cheese"   Color="#F2C14E"/>
        <SolidColorBrush x:Key="Basil"    Color="#7FC26E"/>
        <SolidColorBrush x:Key="Ink"      Color="#F1E8DF"/>
        <SolidColorBrush x:Key="InkDim"   Color="#B9A795"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Cheese}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#150F0C"/>
            <Setter Property="Foreground" Value="{StaticResource Cheese}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Flame}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SolveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Flame}"/>
            <Setter Property="Foreground" Value="#1A0E06"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Cheese}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultBox" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="23"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Inline bar chart — pure XAML, no chart library -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource InkDim}"
                           FontSize="12" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="17" CornerRadius="5"
                        HorizontalAlignment="Left"
                        Width="{Binding Width}" Background="{Binding Fill}"/>
                <TextBlock Grid.Column="2" Text="{Binding Display}" Margin="10,0,0,0"
                           FontSize="12" Foreground="{StaticResource Cheese}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#150F0C"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="RowBackground" Value="#1C1511"/>
            <Setter Property="AlternatingRowBackground" Value="#231A14"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C211B"/>
            <Setter Property="Foreground" Value="{StaticResource Cheese}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A2F1A"/>
                    <Setter Property="Foreground" Value="{StaticResource Cheese}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                Padding="15,9" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontSize="14"
                                              TextBlock.Foreground="{StaticResource InkDim}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2415"/>
                                <Setter Property="TextBlock.Foreground" Value="{StaticResource Cheese}"/>
                                <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1E16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,16">
            <TextBlock FontSize="26" FontWeight="Bold">
                <Run Text="🍕 Pizza Optima" Foreground="#F2C14E"/>
                <Run Text="  |  Operations Research Command Center" Foreground="#F1E8DF"/>
            </TextBlock>
            <TextBlock Foreground="{StaticResource InkDim}" FontSize="13" Margin="2,4,0,0"
                       Text="Simplex · Branch &amp; Bound ILP · M/M/c + Erlang-C · EOQ + Safety Stock · Hungarian O(n³) · Monte-Carlo DES — all solvers hand-built, zero packages"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ════════ TAB 1 · Production Mix ════════ -->
            <TabItem Header="🔥 Production Mix — LP / ILP">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Menu (profit in $, per-pizza resource usage)" Style="{StaticResource SectionTitle}"/>
                                <DataGrid ItemsSource="{Binding Pizzas}" Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pizza" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Profit $" Binding="{Binding Profit}" Width="75"/>
                                        <DataGridTextColumn Header="Dough g" Binding="{Binding Dough}" Width="80"/>
                                        <DataGridTextColumn Header="Cheese g" Binding="{Binding Cheese}" Width="80"/>
                                        <DataGridTextColumn Header="Sauce g" Binding="{Binding Sauce}" Width="75"/>
                                        <DataGridTextColumn Header="Oven min" Binding="{Binding OvenMin}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Daily resource availability" Style="{StaticResource SectionTitle}" Margin="0,18,0,0"/>
                                <UniformGrid Columns="4" Margin="0,6,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Dough (g)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding DoughAvail}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Cheese (g)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding CheeseAvail}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Sauce (g)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding SauceAvail}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Oven (min)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding OvenAvail}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <CheckBox Content="Integer solution (Branch &amp; Bound) — whole pizzas only"
                                          IsChecked="{Binding IntegerMode}" Margin="0,14,0,0"/>

                                <Button Content="⚡ Optimize" Style="{StaticResource SolveButton}"
                                        Command="{Binding SolveLpCommand}" HorizontalAlignment="Left"/>

                                <TextBlock Text="Optimal daily mix" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
                                <ItemsControl ItemsSource="{Binding LpBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LpResult}" Style="{StaticResource ResultBox}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 2 · Queueing ════════ -->
            <TabItem Header="⏳ Customer Queue — M/M/c">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Queue parameters (hourly rates)" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="λ — customer arrival rate (per hour)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Lambda}"/>

                                <TextBlock Text="μ — service rate per cashier (per hour)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Mu}"/>

                                <TextBlock Text="c — number of open cashiers" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Servers}"/>

                                <TextBlock Text="Target: max acceptable queue wait (min)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TargetWqMin}"/>

                                <Button Content="⚡ Analyze queue" Style="{StaticResource SolveButton}"
                                        Command="{Binding SolveQueueCommand}" HorizontalAlignment="Left"/>

                                <TextBlock Text="Avg wait Wq vs. number of cashiers" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
                                <ItemsControl ItemsSource="{Binding QueueBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding QueueResult}" Style="{StaticResource ResultBox}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 3 · Inventory ════════ -->
            <TabItem Header="🧀 Cheese Inventory — EOQ">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Mozzarella inventory parameters" Style="{StaticResource SectionTitle}"/>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Annual demand D (kg)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding AnnualDemand}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Cost per order S ($)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding OrderCost}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Holding cost H ($/kg/yr)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding HoldingCost}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Lead time L (days)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding LeadTimeDays}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Working days / year" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding WorkingDays}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Daily demand std-dev σ (kg)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding DailyStd}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Service level (%)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding ServiceLevel}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Button Content="⚡ Compute EOQ &amp; ROP" Style="{StaticResource SolveButton}"
                                        Command="{Binding SolveEoqCommand}" HorizontalAlignment="Left"/>

                                <TextBlock Text="Total annual cost vs. order quantity (convexity!)" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
                                <ItemsControl ItemsSource="{Binding EoqBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding EoqResult}" Style="{StaticResource ResultBox}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 4 · Dispatch ════════ -->
            <TabItem Header="🛵 Delivery Dispatch — Hungarian">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Travel time matrix — each driver to each zone (min)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Edit any number and re-solve — the answer is always the certified global optimum."
                                       Foreground="{StaticResource InkDim}" FontSize="12" Margin="0,4,0,0"/>
                            <DataGrid ItemsSource="{Binding Drivers}" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="North" Binding="{Binding Z1}" Width="85"/>
                                    <DataGridTextColumn Header="East" Binding="{Binding Z2}" Width="85"/>
                                    <DataGridTextColumn Header="South" Binding="{Binding Z3}" Width="85"/>
                                    <DataGridTextColumn Header="West" Binding="{Binding Z4}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="⚡ Solve assignment" Style="{StaticResource SolveButton}"
                                    Command="{Binding SolveAssignmentCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AssignResult}" Style="{StaticResource ResultBox}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════ TAB 5 · Simulation ════════ -->
            <TabItem Header="🎲 Monte-Carlo Lab — Theory vs. Reality">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Discrete-event simulation of the queue" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Uses λ, μ and c from the Queue tab. Exponential interarrival and service times are sampled, customers grab the earliest-free cashier, and we compare the empirical results against the closed-form M/M/c answers."/>

                                <TextBlock Text="Simulated hours" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SimHours}"/>

                                <TextBlock Text="Random seed (change it → new universe)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding SimSeed}"/>

                                <Button Content="🎲 Run simulation" Style="{StaticResource SolveButton}"
                                        Command="{Binding RunSimCommand}" HorizontalAlignment="Left"/>

                                <TextBlock Text="Wait-time histogram (customers per bin)" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
                                <ItemsControl ItemsSource="{Binding SimBars}" ItemTemplate="{StaticResource BarTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SimResult}" Style="{StaticResource ResultBox}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
